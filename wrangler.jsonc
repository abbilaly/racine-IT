{
"$schema": "./node_modules/wrangler/config-schema.json",
"name": "racine-it",
"main": ".open-next/worker.js",
"compatibility_date": "2026-09-23",
"compatibility_flags": ["nodejs_compat"],
"assets": {
"directory": ".open-next/assets",
"binding": "ASSETS"
},
// No D1 binding is configured because this application uses Supabase
// for order storage when the required SUPABASE_* secrets are configured.
// Do not add a D1 database unless you have a real database ID and intend
// to use that database.
"observability": {
"enabled": true
}
}