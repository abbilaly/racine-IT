# Copy to scripts/backup/backup.env, chmod 600, keep it out of Git.
# scripts/backup/backup.env is gitignored. Values are never committed.

# --- required -------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Use the SESSION pooler (port 5432) or the direct connection, never the
# transaction pooler on 6543: pg_dump needs a real session.
# The password is moved into PGPASSWORD by the script, so it does not appear in
# the process list. Prefer a .pgpass/PGSERVICEFILE where you can.
BACKUP_DB_URL=

# --- encryption (one of these; age is preferred) --------------------------
# Public key only. The private identity stays offline, never on this host.
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=

# --- manifest authenticity ------------------------------------------------
# Recommended: a gpg key id whose secret key lives on this host.
BACKUP_MANIFEST_SIGN_KEY=
# Fallback when gpg is unavailable: HMAC-SHA256 key. Keep it OUTSIDE the backup
# directory and off the backup media, otherwise an attacker with write access
# can re-sign a tampered manifest.
BACKUP_MANIFEST_HMAC_KEY=

# --- storage --------------------------------------------------------------
# Supabase Storage objects are NOT in a database dump. Point rclone at the
# bucket (Supabase S3 endpoint or a mirrored bucket).
BACKUP_STORAGE_REMOTE=
RCLONE_CONFIG=

# --- off-site destination -------------------------------------------------
# Any rclone remote, e.g. r2:abtech-backups or s3:bucket/abtech
BACKUP_OFFSITE=

# --- optional -------------------------------------------------------------
# Defaults to ${XDG_STATE_HOME:-$HOME/.local/state}/abtech-backups (outside the repo)
BACKUP_DIR=
BACKUP_PG_BIN=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_MIN_FREE_MB=512
BACKUP_LOCK_STALE_MINUTES=180

# Rehearsal only. Never set this for a production run: plaintext is refused
# unless --local-drill AND this flag are both present.
# BACKUP_ALLOW_PLAINTEXT=1
